{
  "name": "pb-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "rm -rf .vision-test-build 2>/dev/null || true; tsc -p tsconfig.test.json && node --test .vision-test-build/**/*.test.js",
