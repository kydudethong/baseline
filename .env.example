# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Server-only — NEVER prefix this with NEXT_PUBLIC_ and
# never import it from a Client Component. Used for privileged server-side
# operations (e.g. background processing jobs) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ------------------------------------------------------------------
# Public base URL of this deployment, used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: real CV pipeline -------------------------------------------
# Roboflow hosted inference — player detection (pretrained COCO model,
# `person` class, no training required). Get a key at roboflow.com; the
# free tier (15 credits/mo, ~1000 inferences/credit) comfortably covers
# testing against a few minutes of footage at VISION_FPS=5.
ROBOFLOW_API_KEY=
# Optional overrides — defaults match Roboflow's classic Hosted Inference
# API (detect.roboflow.com/coco/50). Only set these if that's moved/changed.
# ROBOFLOW_HOST=https://detect.roboflow.com
# ROBOFLOW_MODEL_ID=coco/50

# How many frames per second of source video actually get run through CV.
# Never process all 60fps — see scripts/cv/ and src/lib/vision/. 5 is a
# reasonable default; raise it for finer-grained tracking at proportionally
# higher Roboflow credit cost.
VISION_FPS=5

# "roboflow" for the real pipeline, "mock" (default) for clearly-labeled
# synthetic data during local development without CV credentials.
VISION_PROVIDER=mock

# "v2" (default) runs the real Phase 2 pipeline async; "v1" falls back to
# the original Phase 1 synchronous mock pipeline. See process/route.ts.
# PIPELINE_VERSION=v2

# --- Baseline coaching layer ----------------------------------------------
# Anthropic Claude — turns Rally IQ's own CV facts (src/lib/coaching/facts.ts)
# into the coaching read + tagged skill records (src/lib/coaching/*). Get a
# key at https://platform.claude.com/settings/keys (no free tier, but this
# module's volume — a compact facts JSON in, a short narrative out, twice
# per analysis — costs a fraction of a cent per run on Haiku). Called from
# /api/analyses/[id]/coach, once a player is tagged as "you" for a
# completed analysis — see 0005_coaching_layer.sql.
ANTHROPIC_API_KEY=
# Optional: pin a different model than the Haiku default (see
# DEFAULT_MODEL in lib/coaching/claude.ts).
# CLAUDE_MODEL=
# Optional: only needed if your key is identity-linked/multi-workspace
# (the API will 400 and tell you if so). Find it at
# https://platform.claude.com/settings — Workspaces tab, ID column.
# ANTHROPIC_WORKSPACE_ID=
