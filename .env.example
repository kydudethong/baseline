# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Server-only — NEVER prefix this with NEXT_PUBLIC_ and
# never import it from a Client Component. Used for privileged server-side
# operations (e.g. background processing jobs) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ------------------------------------------------------------------
# Public base URL of this deployment, used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Video storage (Cloudflare R2) ---------------------------------------
# Match footage lives in R2, not Supabase Storage: Supabase enforces a
# project-wide per-file cap regardless of a bucket's own file_size_limit
# (50MB on Free, 500GB on Pro), and R2 charges nothing for egress, which
# matters because the vision pipeline re-downloads the full video on every
# processing run. Supabase still handles auth and the Postgres data model —
# only the video bytes moved. Small debug frame JPGs stay on Supabase
# Storage (well under any size cap, not worth a second migration).
#
# One-time setup in the Cloudflare dashboard:
#   1. R2 -> create a bucket (any name, e.g. "pb-analyzer-videos").
#   2. R2 -> Manage API Tokens -> create a token scoped to that bucket,
#      with Object Read & Write permission. Copy the Access Key ID,
#      Secret Access Key, and the Account ID shown on the R2 overview page.
#   3. On the bucket -> Settings -> CORS Policy, add a rule allowing PUT/GET
#      from this app's origin(s) and exposing the ETag header — uploads go
#      straight from the browser to R2, so without this the browser can't
#      read the ETag each part upload needs. Example:
#      [{
#        "AllowedOrigins": ["http://localhost:3000", "https://your-deployed-domain"],
#        "AllowedMethods": ["PUT", "GET"],
#        "AllowedHeaders": ["*"],
#        "ExposeHeaders": ["ETag"]
#      }]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Phase 2: real CV pipeline -------------------------------------------
# Roboflow hosted inference — player detection (pretrained COCO model,
# `person` class, no training required). Get a key at roboflow.com; the
# free tier (15 credits/mo, ~1000 inferences/credit) comfortably covers
# testing against a few minutes of footage at VISION_FPS=5.
ROBOFLOW_API_KEY=
# Optional overrides — defaults match Roboflow's classic Hosted Inference
# API (detect.roboflow.com/coco/50). Only set these if that's moved/changed.
# ROBOFLOW_HOST=https://detect.roboflow.com
# ROBOFLOW_MODEL_ID=coco/50

# How many frames per second of source video actually get run through CV.
# Never process all 60fps — see scripts/cv/ and src/lib/vision/. 5 is a
# reasonable default; raise it for finer-grained tracking at proportionally
# higher Roboflow credit cost.
VISION_FPS=5

# "roboflow" for the real pipeline, "mock" (default) for clearly-labeled
# synthetic data during local development without CV credentials.
VISION_PROVIDER=mock

# "v2" (default) runs the real Phase 2 pipeline async; "v1" falls back to
# the original Phase 1 synchronous mock pipeline. See process/route.ts.
# PIPELINE_VERSION=v2

# --- Baseline coaching layer ----------------------------------------------
# Anthropic Claude — turns Rally IQ's own CV facts (src/lib/coaching/facts.ts)
# into the coaching read + tagged skill records (src/lib/coaching/*). Get a
# key at https://platform.claude.com/settings/keys (no free tier, but this
# module's volume — a compact facts JSON in, a short narrative out, twice
# per analysis — costs a fraction of a cent per run on Haiku). Called from
# /api/analyses/[id]/coach, once a player is tagged as "you" for a
# completed analysis — see 0005_coaching_layer.sql.
ANTHROPIC_API_KEY=
# Optional: pin a different model than the Haiku default (see
# DEFAULT_MODEL in lib/coaching/claude.ts).
# CLAUDE_MODEL=
# Optional: only needed if your key is identity-linked/multi-workspace
# (the API will 400 and tell you if so). Find it at
# https://platform.claude.com/settings — Workspaces tab, ID column.
# ANTHROPIC_WORKSPACE_ID=

# --- Ball detection / shot classification (src/lib/vision/ball.ts, shots.ts) ---
# A Roboflow model id — a public Roboflow Universe model or one you trained —
# in the form workspace/project/version. When set, every audio-segmented
# rally is scanned for the ball at native frame rate and each paddle contact
# is classified (serve, return, third-shot drop, dink, drive, reset, ...).
# Leave empty and the pipeline honestly reports "shot types not classified".
BALL_MODEL_ID=
# local (default): run the model on this machine via `pip install inference`
#   (weights download once with ROBOFLOW_API_KEY, then run offline).
# hosted: one serverless.roboflow.com call per frame (~0.2 s each, one
#   inference credit each). Use this when the model is too heavy to run
#   locally — RF-DETR models take ~3 s/frame on a laptop CPU. A YOLO-family
#   model (Roboflow 3.0 / YOLOv8) runs fine locally.
BALL_INFERENCE=local
# Or, instead of a Roboflow id, a local Ultralytics weights file:
# BALL_MODEL_PATH=models/ball.pt
# Tuning: detection threshold, frame-rate cap, inference image size.
# BALL_CONFIDENCE=0.25
# BALL_FPS_CAP=15   (15 is enough for bounces and hits; 30 doubles the time)
# BALL_IMGSZ=1280
# What the calibrated court quadrilateral covers: near-half (baseline to
# net — the default the court detector was built for) or full.
# COURT_QUAD=near-half

# --- CV compute -------------------------------------------------------------
# Player detection. "local" (the default) runs models/yolov8n.pt on this
# machine and costs nothing. "roboflow" uses the hosted coco/50 model and
# spends one credit per sampled frame -- roughly 500 per 100-second clip at
# VISION_FPS=5, which exhausts a free tier in a few runs.
PLAYER_DETECTION=local
PLAYER_MODEL_PATH=models/yolov8n.pt
PLAYER_CONF=0.25
PLAYER_IMGSZ=960

# Ball detection. Two ways to avoid the API entirely:
#   BALL_MODEL_PATH=models/ball.pt   a YOLO .pt on disk -- no key, no credits
#   BALL_MODEL_ID + BALL_INFERENCE=local  downloads Roboflow weights once with
#                                          the key, then runs offline
# BALL_MODEL_PATH wins when both are set.
BALL_MODEL_PATH=
BALL_MODEL_ID=
BALL_INFERENCE=local
BALL_FPS_CAP=15

# Interpreter used for every scripts/cv/*.py call. Leave unset to use whatever
# `python3` resolves to. Point it at one environment when your packages are
# split across several — e.g. /Users/you/coach/ml/.venv/bin/python
CV_PYTHON=

# Rally segmentation. Net crossings is the default and the one measured on real
# footage. CONTACT_RALLIES=on switches to grouping paddle contacts and requiring
# both sides to have hit the ball -- a cleaner rule, but it needs every contact
# to be detected, which needs better ball coverage than 26%.
CONTACT_RALLIES=off
NET_RALLIES=on

# --- Idle sleep (Fly only) --------------------------------------------------
# Stops the machine when nothing is happening, so idle hours cost nothing. Fly
# restarts it on the next request by itself (auto_start_machines), so the site
# stays reachable -- the first visitor after a sleep pays a cold start.
#
# OFF unless all three of FLY_API_TOKEN, FLY_APP_NAME and FLY_MACHINE_ID are
# present. Fly injects the last two into every machine; the token is yours to
# create and set:
#
#   fly tokens create deploy --name idle-sleep --expiry 8760h
#   fly secrets set FLY_API_TOKEN=<the token> --app baseline-court
#
# It is app-scoped, not org-scoped, so the worst it can do is act on this one
# app. Give it an expiry -- tokens default to twenty years.
#
# The machine never sleeps while an analysis is running on it, because runs
# live in the server process's memory and it counts them.
# IDLE_SLEEP_MINUTES=20
# IDLE_SLEEP=off            # disable entirely even with a token present
