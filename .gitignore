# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Phase 2 CV scratch
scripts/cv/__pycache__/
benchmark-results/

# Generated at runtime by the vision pipeline and the setup page
public/rally-debug/
public/setup-frames/
.vision-test-build/

# CV experiment + debug-run scratch (regenerated on demand, never an input)
scripts/__pycache__/
ml-experiments/__pycache__/
ml-experiments/detector-compare/
ml-experiments/detector-compare-indoor/
ml-experiments/paddle-debug/
ml-experiments/*.json
shot-results/
ball_debug_*.txt
tracknet_result.json
/_*.png
_to_delete/

# Python virtualenvs (the Gemini harness wants google-genai, and Homebrew's
# python refuses system-wide installs under PEP 668)
.venv/
.venv-*/
